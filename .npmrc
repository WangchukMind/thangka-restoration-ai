# npm配置文件
# 配置GitHub Packages注册表
# Developed by Wangchuk Mind

# GitHub Packages注册表配置
@wangchukmind:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# 公共npm注册表配置
registry=https://registry.npmjs.org/

# 包发布配置
save-exact=true
package-lock=true
fund=false
audit=false

# 缓存配置
cache-min=86400
cache-max=604800

# 日志配置
loglevel=warn
progress=true

# 安全配置
strict-ssl=true
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
