{
  "name": "@wangchukmind/thangka-repair-ai",
  "version": "1.0.0",
  "description": "AI-powered Thangka restoration system with cultural learning features",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd Django && python -m py_compile server/**/*.py",
    "start": "python start_mvp_product.py",
    "start:kiosk": "python start_mvp_product.py --kiosk-mode",
    "dev": "concurrently \"cd client && npm start\" \"cd Django && python manage.py runserver\"",
    "test": "npm run test:client && npm run test:server",
    "test:client": "cd client && npm test",
    "test:server": "cd Django && python manage.py test",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd client && npm run lint",
    "lint:server": "cd Django && python -m flake8 server/",
    "deploy": "npm run build && npm run deploy:docker",
    "deploy:docker": "docker build -t ghcr.io/wangchukmind/thangka-repair-ai . && docker push ghcr.io/wangchukmind/thangka-repair-ai",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com",
    "publish:public": "npm publish --registry=https://registry.npmjs.org"
  },
  "keywords": [
    "thangka",
    "ai",
    "restoration",
    "cultural-heritage",
    "paddlepaddle",
    "lora",
    "tibetan-art",
    "machine-learning",
    "computer-vision",
    "cultural-learning"
  ],
  "author": {
    "name": "Wangchuk Mind",
    "email": "wangchukmind@example.com",
    "url": "https://github.com/WangchukMind"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WangchukMind/thangka-restoration-ai.git"
  },
  "bugs": {
    "url": "https://github.com/WangchukMind/thangka-restoration-ai/issues"
  },
  "homepage": "https://github.com/WangchukMind/thangka-restoration-ai#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0",
    "python": ">=3.9.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "axios": "^1.3.0",
    "lucide-react": "^0.263.0",
    "django": "^4.2.0",
    "paddlepaddle": "^2.5.0",
    "pillow": "^9.5.0",
    "numpy": "^1.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/node": "^18.15.0",
    "typescript": "^4.9.5",
    "concurrently": "^7.6.0",
    "eslint": "^8.36.0",
    "prettier": "^2.8.4",
    "webpack": "^5.76.0",
    "webpack-cli": "^5.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@wangchukmind:registry": "https://npm.pkg.github.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/WangchukMind"
  }
}
