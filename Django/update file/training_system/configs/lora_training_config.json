{
  "model": {
    "base_model": "stabilityai/stable-diffusion-3-medium",
    "target_modules": [
      "to_k",
      "to_q",
      "to_v",
      "to_out.0"
    ],
    "rank": 16,
    "alpha": 32,
    "dropout": 0.1
  },
  "training": {
    "learning_rate": 0.0001,
    "batch_size": 4,
    "num_epochs": 100,
    "save_steps": 500,
    "eval_steps": 100,
    "gradient_accumulation_steps": 4,
    "max_grad_norm": 1.0,
    "warmup_steps": 100
  },
  "data": {
    "train_data_dir": "./datasets/thangka_images",
    "resolution": 1024,
    "center_crop": true,
    "random_flip": true
  },
  "optimizer": {
    "type": "AdamW",
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "scheduler": {
    "type": "cosine",
    "warmup_ratio": 0.1
  }
}