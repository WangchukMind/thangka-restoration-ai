      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/node": "^18.15.0",
    "typescript": "^4.9.5",
    "eslint": "^8.36.0",
    "prettier": "^2.8.4"
